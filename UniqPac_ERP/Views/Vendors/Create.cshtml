@model UniqPac_ERP.Models.Vendor

@{
    ViewData["Title"] = "Create Vendors";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Create Vendor</h2>
            <p class="text-muted mb-0">Add a new vendor to the system.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="VendorCategoryId" class="form-label fw-bold">Vendor Category <span class="text-danger">*</span></label>
                        <select asp-for="VendorCategoryId" class ="form-select" asp-items="ViewBag.VendorCategoryId">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="VendorCategoryId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold">Vendor Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VendorType" class="form-label fw-bold">Vendor Type</label>
                        <input asp-for="VendorType" class="form-control" placeholder="e.g. Manufacturer, Supplier" />
                        <span asp-validation-for="VendorType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ContactPerson" class="form-label fw-bold">Contact Person</label>
                        <input asp-for="ContactPerson" class="form-control" />
                        <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-bold">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-bold">Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="GSTNo" class="form-label fw-bold">GST Number</label>
                        <input asp-for="GSTNo" class="form-control text-uppercase" />
                        <span asp-validation-for="GSTNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PanNo" class="form-label fw-bold">PAN Number</label>
                        <input asp-for="PanNo" class="form-control text-uppercase" />
                        <span asp-validation-for="PanNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Rating" class="form-label fw-bold">Rating (1-5)</label>
                        <input asp-for="Rating" class="form-control" type="number" min="1" max="5" step="0.1" />
                        <span asp-validation-for="Rating" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="Address" class="form-label fw-bold">Address</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="City" class="form-label fw-bold">City</label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="State" class="form-label fw-bold">State</label>
                        <input asp-for="State" class="form-control" />
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ZipCode" class="form-label fw-bold">ZIP Code</label>
                        <input asp-for="ZipCode" class="form-control" />
                        <span asp-validation-for="ZipCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Country" class="form-label fw-bold">Country</label>
                        <input asp-for="Country" class="form-control" value="India" />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <label asp-for="BankDetails" class="form-label fw-bold">Bank Details</label>
                        <textarea asp-for="BankDetails" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="BankDetails" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PaymentTerms" class="form-label fw-bold">Payment Terms</label>
                        <input asp-for="PaymentTerms" class="form-control" placeholder="e.g. Net 30, COD" />
                        <span asp-validation-for="PaymentTerms" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LeadTimeDays" class="form-label fw-bold">Lead Time (Days)</label>
                        <input asp-for="LeadTimeDays" class="form-control" type="number" min="0" />
                        <span asp-validation-for="LeadTimeDays" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" asp-for="IsActive" checked />
                            <label class="form-check-label ms-2" asp-for="IsActive">Vendor is Active</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">Create Vendor</button>
                    <a asp-action="Index" class="btn btn-light border shadow-sm">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
