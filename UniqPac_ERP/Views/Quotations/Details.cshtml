@model UniqPac_ERP.Models.Quotation

@{
    ViewData["Title"] = "Quotation Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0 text-gray-800 fw-bold">@ViewData["Title"]</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary me-2 shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-light border shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h6 class="m-0 font-weight-bold text-primary">@Model!.QuotationNo</h6>
        </div>
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Customer</h6>
                    <p class="fw-bold fs-5">@Model.Customer.Name</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Valid Until</h6>
                    <p class="fw-bold">@(Model.ValidUntil.HasValue ? Model.ValidUntil.Value.ToString("dd/MM/yyyy") : "-")</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Status</h6>
                    <p class="fw-bold">
                        @if (Model.Status == "Draft")
                        {
                            <span class="badge bg-secondary">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">@Model.Status</span>
                        }
                    </p>
                </div>
            </div>
            
            @if (!string.IsNullOrEmpty(Model.Terms) || !string.IsNullOrEmpty(Model.Remarks))
            {
                <div class="row mb-4 bg-light p-3 rounded">
                    @if (!string.IsNullOrEmpty(Model.Terms))
                    {
                        <div class="col-md-6">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Terms</h6>
                            <p class="mb-0">@Model.Terms</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Remarks))
                    {
                        <div class="col-md-6">
                            <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Remarks</h6>
                            <p class="mb-0">@Model.Remarks</p>
                        </div>
                    }
                </div>
            }

            <h5 class="fw-bold mb-3 mt-4 border-bottom pb-2">Line Items</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Rate (₹)</th>
                            <th class="text-end">Disc %</th>
                            <th class="text-end fw-bold">Line Total (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.QuotationItems != null && Model.QuotationItems.Any())
                        {
                            foreach (var item in Model.QuotationItems)
                            {
                                <tr>
                                    <td>@item.Description</td>
                                    <td class="text-end">@item.Quantity</td>
                                    <td class="text-end">@item.UnitRate.ToString("N2")</td>
                                    <td class="text-end">@item.DiscountPercentage</td>
                                    <td class="text-end fw-bold">@item.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">No items found.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="4" class="text-end fw-bold">Grand Total:</td>
                            <td class="text-end fw-bold fs-5 text-primary">₹@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-5 pt-3 border-top text-muted small d-flex justify-content-between">
                <div>Created by: <strong>@Model.CreatedBy</strong> on @Model.CreatedAt.ToString("g")</div>
                @if (Model.UpdatedAt.HasValue)
                {
                    <div>Last updated by: <strong>@Model.UpdatedBy</strong> on @Model.UpdatedAt.Value.ToString("g")</div>
                }
            </div>
        </div>
    </div>
</div>
