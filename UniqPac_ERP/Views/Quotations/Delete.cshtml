@model UniqPac_ERP.Models.Quotation

@{
    ViewData["Title"] = "Delete Quotation";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0 text-gray-800 fw-bold">@ViewData["Title"]</h2>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white py-3">
            <h6 class="m-0 font-weight-bold">Are you sure you want to delete this?</h6>
        </div>
        <div class="card-body p-4">
            <h4 class="mb-3 text-danger">Quotation: @Model.QuotationNo</h4>
            
            <dl class="row">
                <dt class="col-sm-3">Customer</dt>
                <dd class="col-sm-9 fw-bold">@Model.Customer.Name</dd>

                <dt class="col-sm-3">Valid Until</dt>
                <dd class="col-sm-9">@(Model.ValidUntil.HasValue ? Model.ValidUntil.Value.ToString("dd/MM/yyyy") : "-")</dd>

                <dt class="col-sm-3">Total Amount</dt>
                <dd class="col-sm-9">₹@Model.TotalAmount.ToString("N2")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger px-4 shadow-sm">Delete</button>
                <a asp-action="Index" class="btn btn-light border ms-2 shadow-sm">Cancel</a>
            </form>
        </div>
    </div>
</div>
