@model UniqPac_ERP.Models.Customer

@{
    ViewData["Title"] = "Create Customer";
}

<div class="card shadow-sm border-0" style="max-width: 900px; margin: 0 auto;">
    <div class="card-header bg-white border-bottom p-4">
        <h4 class="mb-1 fw-bold text-dark">Create Customer</h4>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Register a new customer profile with contact, billing, and tax details.</p>
    </div>
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <!-- Basic Information Group -->
            <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom" style="font-size: 1.1rem;">Basic Information</h5>
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label asp-for="CustomerCode" class="form-label fw-semibold text-secondary">Customer Code <span class="text-danger">*</span></label>
                    <input asp-for="CustomerCode" class="form-control" placeholder="e.g. CUST0001" readonly />
                    <span asp-validation-for="CustomerCode" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-secondary">Customer Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Acme Corporation" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CustomerType" class="form-label fw-semibold text-secondary">Customer Type</label>
                    <input asp-for="CustomerType" class="form-control" placeholder="e.g. Wholesale, Retail, Corporate" />
                    <span asp-validation-for="CustomerType" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ContactPerson" class="form-label fw-semibold text-secondary">Contact Person</label>
                    <input asp-for="ContactPerson" class="form-control" placeholder="e.g. John Doe" />
                    <span asp-validation-for="ContactPerson" class="text-danger"></span>
                </div>
                <div class="col-md-12 mb-3">
                    <label asp-for="Website" class="form-label fw-semibold text-secondary">Website</label>
                    <input asp-for="Website" class="form-control" placeholder="e.g. https://www.example.com" />
                    <span asp-validation-for="Website" class="text-danger"></span>
                </div>
            </div>

            <!-- Contact & Address Group -->
            <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom mt-4" style="font-size: 1.1rem;">Contact & Address Details</h5>
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary">Email Address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="e.g. email@example.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold text-secondary">Phone Number</label>
                    <input asp-for="Phone" class="form-control" placeholder="e.g. +1-234-567-8900" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <!-- Billing Side -->
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="BillingAddress" class="form-label fw-semibold text-secondary"></label>
                            <textarea asp-for="BillingAddress" class="form-control" rows="2" placeholder="Street, Building, Suite..."></textarea>
                            <span asp-validation-for="BillingAddress" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="City" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="City" class="form-control" placeholder="Billing City" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="State" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="State" class="form-control" placeholder="Billing State" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ZipCode" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ZipCode" class="form-control" placeholder="Billing Zip Code" />
                            <span asp-validation-for="ZipCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Country" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Country" class="form-control" placeholder="Billing Country" />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                
                <!-- Shipping Side -->
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <label asp-for="ShippingAddress" class="form-label fw-semibold text-secondary"></label>
                            <textarea asp-for="ShippingAddress" class="form-control" rows="2" placeholder="Leave empty if same as Billing"></textarea>
                            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ShippingCity" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ShippingCity" class="form-control" placeholder="Shipping City" />
                            <span asp-validation-for="ShippingCity" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ShippingState" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ShippingState" class="form-control" placeholder="Shipping State" />
                            <span asp-validation-for="ShippingState" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ShippingZipCode" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ShippingZipCode" class="form-control" placeholder="Shipping Zip Code" />
                            <span asp-validation-for="ShippingZipCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ShippingCountry" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="ShippingCountry" class="form-control" placeholder="Shipping Country" />
                            <span asp-validation-for="ShippingCountry" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Financials & Tax Group -->
            <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom mt-4" style="font-size: 1.1rem;">Financials & Tax Information</h5>
            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <label asp-for="GSTNo" class="form-label fw-semibold text-secondary">GST No</label>
                    <input asp-for="GSTNo" class="form-control" placeholder="e.g. 22AAAAA0000A1Z5" />
                    <span asp-validation-for="GSTNo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PanNo" class="form-label fw-semibold text-secondary">PAN No</label>
                    <input asp-for="PanNo" class="form-control" placeholder="e.g. ABCDE1234F" />
                    <span asp-validation-for="PanNo" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="CreditLimit" class="form-label fw-semibold text-secondary">Credit Limit (₹)</label>
                    <input asp-for="CreditLimit" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="CreditLimit" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="PaymentTerms" class="form-label fw-semibold text-secondary">Payment Terms</label>
                    <input asp-for="PaymentTerms" class="form-control" placeholder="e.g. Net 30, COD" />
                    <span asp-validation-for="PaymentTerms" class="text-danger"></span>
                </div>
                <div class="col-md-12 mb-3">
                    <label asp-for="BankDetails" class="form-label fw-semibold text-secondary">Bank Details</label>
                    <textarea asp-for="BankDetails" class="form-control" rows="2" placeholder="Bank Name, A/C No, IFSC/Routing code..."></textarea>
                    <span asp-validation-for="BankDetails" class="text-danger"></span>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="row mt-5">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary px-4 py-2 me-2" style="font-weight: 500;"><i class="ph ph-check"></i> Save Customer</button>
                    <a asp-action="Index" class="btn btn-light px-4 py-2 border text-dark" style="font-weight: 500;">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
