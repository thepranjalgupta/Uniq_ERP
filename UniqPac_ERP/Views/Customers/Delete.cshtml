@model UniqPac_ERP.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="card shadow-sm border-0" style="max-width: 900px; margin: 0 auto;">
    <div class="card-header bg-white border-bottom p-4">
        <h4 class="mb-1 fw-bold text-danger">Delete Customer</h4>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Are you sure you want to permanently delete this customer record?</p>
    </div>
    
    <div class="alert alert-warning border-0 rounded-0 m-0 px-4 py-3 d-flex align-items-center" role="alert">
        <i class="ph ph-warning fs-4 me-2"></i>
        <div>
            <strong>Warning:</strong> Deleting this customer will remove their records. If there are dependent jobs or invoices, this action might be restricted or result in integrity issues.
        </div>
    </div>

    <div class="card-body p-4 p-md-5">
        <!-- Basic Information -->
        <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom" style="font-size: 1.1rem;">Basic Information</h5>
        <div class="row mb-4">
            <div class="col-sm-4 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Customer Code</span>
                <span class="text-dark fs-6 fw-bold">@Model.CustomerCode</span>
            </div>
            <div class="col-sm-8 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Customer Name</span>
                <span class="text-dark fs-6">@Model.Name</span>
            </div>
            <div class="col-sm-4 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Customer Type</span>
                <span class="text-dark fs-6">@(Model.CustomerType ?? "-")</span>
            </div>
            <div class="col-sm-4 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Contact Person</span>
                <span class="text-dark fs-6">@(Model.ContactPerson ?? "-")</span>
            </div>
            <div class="col-sm-4 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Website</span>
                <span class="text-dark fs-6">
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <a href="@Model.Website" target="_blank">@Model.Website</a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </span>
            </div>
        </div>

        <!-- Contact & Address Details -->
        <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom mt-4" style="font-size: 1.1rem;">Contact & Address Details</h5>
        <div class="row mb-4">
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Email Address</span>
                <span class="text-dark fs-6">@(Model.Email ?? "-")</span>
            </div>
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Phone Number</span>
                <span class="text-dark fs-6">@(Model.Phone ?? "-")</span>
            </div>
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Billing Address</span>
                <span class="text-dark fs-6" style="white-space: pre-line;">@(Model.BillingAddress ?? "-")</span>
            </div>
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Shipping Address</span>
                <span class="text-dark fs-6" style="white-space: pre-line;">@(Model.ShippingAddress ?? "-")</span>
            </div>
            <div class="col-sm-3 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">City</span>
                <span class="text-dark fs-6">@(Model.City ?? "-")</span>
            </div>
            <div class="col-sm-3 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">State</span>
                <span class="text-dark fs-6">@(Model.State ?? "-")</span>
            </div>
            <div class="col-sm-3 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Zip/Postal Code</span>
                <span class="text-dark fs-6">@(Model.ZipCode ?? "-")</span>
            </div>
            <div class="col-sm-3 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Country</span>
                <span class="text-dark fs-6">@(Model.Country ?? "-")</span>
            </div>
        </div>

        <!-- Financials & Tax Information -->
        <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom mt-4" style="font-size: 1.1rem;">Financials & Tax Information</h5>
        <div class="row mb-4">
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">GST No</span>
                <span class="text-dark fs-6">@(Model.GSTNo ?? "-")</span>
            </div>
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">PAN No</span>
                <span class="text-dark fs-6">@(Model.PanNo ?? "-")</span>
            </div>
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Credit Limit</span>
                <span class="text-dark fs-6">@(Model.CreditLimit.HasValue ? Model.CreditLimit.Value.ToString("C") : "-")</span>
            </div>
            <div class="col-sm-6 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Payment Terms</span>
                <span class="text-dark fs-6">@(Model.PaymentTerms ?? "-")</span>
            </div>
            <div class="col-sm-12 mb-3">
                <span class="text-secondary fw-semibold d-block" style="font-size: 0.85rem;">Bank Details</span>
                <span class="text-dark fs-6" style="white-space: pre-line;">@(Model.BankDetails ?? "-")</span>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="row mt-5 border-top pt-4">
            <div class="col-12">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger px-4 py-2 me-2" style="font-weight: 500;"><i class="ph ph-trash"></i> Confirm Delete</button>
                    <a asp-action="Index" class="btn btn-light px-4 py-2 border text-dark" style="font-weight: 500;">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>