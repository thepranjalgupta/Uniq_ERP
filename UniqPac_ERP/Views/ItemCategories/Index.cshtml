@model IEnumerable<UniqPac_ERP.Models.ItemCategory>

@{
    ViewData["Title"] = "Manage ItemCategories";
}

<div class="card">
<div class="card-header d-flex justify-content-between align-items-center">
<h4 class="mb-0">Records</h4>
<a asp-action="Create" class="btn btn-primary"><i class="ph ph-plus"></i> Create New</a>
</div>
<div class="card-body p-0">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryCode)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryCode)
            </td>
            <td>
                <a asp-action="Edit" class="btn btn-sm btn-light" asp-route-id="@item.Id">Edit</a>
                <a asp-action="Details" class="btn btn-sm btn-light me-1" asp-route-id="@item.Id">Details</a>
                <a asp-action="Delete" class="btn btn-sm btn-danger" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

</div>
</div>
</div>