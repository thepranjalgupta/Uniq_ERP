@model UniqPac_ERP.Models.GoodsReceiptNote

@{
    ViewData["Title"] = "Edit GRN";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Edit GRN</h2>
            <p class="text-muted mb-0">Update Goods Receipt Note @Model.GRNNumber</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <form asp-action="Edit" id="grnForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-3">
                        <label asp-for="GRNNumber" class="form-label fw-bold"></label>
                        <input asp-for="GRNNumber" class="form-control bg-light" readonly />
                        <span asp-validation-for="GRNNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="GRNDate" class="form-label fw-bold"></label>
                        <input asp-for="GRNDate" class="form-control" type="date" />
                        <span asp-validation-for="GRNDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PurchaseOrderId" class="form-label fw-bold"></label>
                        <select asp-for="PurchaseOrderId" class="form-select" asp-items="ViewBag.PurchaseOrderId">
                            <option value="">-- Select PO (Optional) --</option>
                        </select>
                        <span asp-validation-for="PurchaseOrderId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="VendorId" class="form-label fw-bold"></label>
                        <select asp-for="VendorId" class="form-select" asp-items="ViewBag.VendorId" required>
                            <option value="">-- Select Vendor --</option>
                        </select>
                        <span asp-validation-for="VendorId" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ChallanNumber" class="form-label fw-bold"></label>
                        <input asp-for="ChallanNumber" class="form-control" />
                        <span asp-validation-for="ChallanNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="ChallanDate" class="form-label fw-bold"></label>
                        <input asp-for="ChallanDate" class="form-control" type="date" />
                        <span asp-validation-for="ChallanDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="VehicleNumber" class="form-label fw-bold"></label>
                        <input asp-for="VehicleNumber" class="form-control" />
                        <span asp-validation-for="VehicleNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Status" class="form-label fw-bold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Pending">Pending</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mb-3 text-gray-800">Received Items <span class="text-danger">*</span></h5>
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0" id="itemsTable">
                        <thead class="bg-light">
                            <tr>
                                <th>Item Name</th>
                                <th style="width: 12%;">Expected Qty</th>
                                <th style="width: 12%;">Received Qty</th>
                                <th style="width: 12%;">Accepted Qty</th>
                                <th style="width: 12%;">Rejected Qty</th>
                                <th style="width: 20%;">Remarks</th>
                                <th style="width: 10%;">Details</th>
                                <th style="width: 5%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.GoodsReceiptNoteItems != null)
                            {
                                for (int i = 0; i < Model.GoodsReceiptNoteItems.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <input type="hidden" asp-for="GoodsReceiptNoteItems[i].Id" />
                                            <select asp-for="GoodsReceiptNoteItems[i].ItemId" class="form-select item-id-select" asp-items="ViewBag.ItemId" required>
                                                <option value="">-- Select Item --</option>
                                            </select>
                                            <input type="hidden" asp-for="GoodsReceiptNoteItems[i].ItemName" />
                                            <span asp-validation-for="GoodsReceiptNoteItems[i].ItemId" class="text-danger d-block mt-1 small"></span>
                                        </td>
                                        <td>
                                            <input asp-for="GoodsReceiptNoteItems[i].ExpectedQuantity" class="form-control expected-qty" type="number" step="0.01" />
                                        </td>
                                        <td>
                                            <input asp-for="GoodsReceiptNoteItems[i].ReceivedQuantity" class="form-control received-qty calc-trigger" type="number" step="0.01" required />
                                        </td>
                                        <td>
                                            <input asp-for="GoodsReceiptNoteItems[i].AcceptedQuantity" class="form-control accepted-qty calc-trigger" type="number" step="0.01" required />
                                        </td>
                                        <td>
                                            <input asp-for="GoodsReceiptNoteItems[i].RejectedQuantity" class="form-control rejected-qty bg-light" type="number" step="0.01" readonly />
                                        </td>
                                        <td>
                                            <input asp-for="GoodsReceiptNoteItems[i].Remarks" class="form-control" />
                                        </td>
                                        <td class="text-center align-middle">
                                            @if (ViewBag.POType == "Cylinder")
                                            {
                                                <button type="button" class="btn btn-outline-info btn-sm btn-details" data-type="Cylinder" data-index="@i">
                                                    <i class="bi bi-list-ul"></i> Cylinders
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-info btn-sm btn-details" data-type="Roll" data-index="@i">
                                                    <i class="bi bi-list-ul"></i> Rolls
                                                </button>
                                            }
                                            <div class="item-details-container" id="details-container-@i">
                                                @if (Model.GoodsReceiptNoteItems[i].Rolls != null)
                                                {
                                                    int rollCount = 0;
                                                    foreach (var roll in Model.GoodsReceiptNoteItems[i].Rolls)
                                                    {
                                                        <input type="hidden" name="GoodsReceiptNoteItems[@i].Rolls[@rollCount].RollNo" value="@roll.RollNo" />
                                                        <input type="hidden" name="GoodsReceiptNoteItems[@i].Rolls[@rollCount].RollWeight" value="@roll.RollWeight" />
                                                        rollCount++;
                                                    }
                                                }
                                                @if (Model.GoodsReceiptNoteItems[i].Cylinders != null)
                                                {
                                                    int cylCount = 0;
                                                    foreach (var cyl in Model.GoodsReceiptNoteItems[i].Cylinders)
                                                    {
                                                        <input type="hidden" name="GoodsReceiptNoteItems[@i].Cylinders[@cylCount].CylinderNo" value="@cyl.CylinderNo" />
                                                        cylCount++;
                                                    }
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center align-middle">
                                            <button type="button" class="btn btn-outline-danger btn-sm remove-item" tabindex="-1">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top bg-light">
                    <button type="button" class="btn btn-outline-primary btn-sm bg-white" id="btnAddItem">
                        <i class="bi bi-plus-lg"></i> Add Item
                    </button>
                </div>
            </div>
        </div>
        
        <div class="mb-4">
            <label asp-for="Remarks" class="form-label fw-bold">General Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Remarks" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4 shadow-sm">Save Changes</button>
            <a asp-action="Index" class="btn btn-light border shadow-sm">Cancel</a>
        </div>
    </form>
</div>

<!-- Rolls Modal -->
<div class="modal fade" id="rollsModal" tabindex="-1" aria-labelledby="rollsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rollsModalLabel">Rolls Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentRollItemIndex" />
                <table class="table table-bordered" id="rollsTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Roll No</th>
                            <th>Roll Weight (Kg)</th>
                            <th style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddRollRow"><i class="bi bi-plus"></i> Add Roll</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveRolls">Save Rolls</button>
            </div>
        </div>
    </div>
</div>

<!-- Cylinders Modal -->
<div class="modal fade" id="cylindersModal" tabindex="-1" aria-labelledby="cylindersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cylindersModalLabel">Cylinders Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="currentCylinderItemIndex" />
                <table class="table table-bordered" id="cylindersTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Cylinder No</th>
                            <th style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddCylinderRow"><i class="bi bi-plus"></i> Add Cylinder</button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveCylinders">Save Cylinders</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function () {
            let itemIndex = $('#itemsTable tbody tr').length;

            function calculateRejection(row) {
                const received = parseFloat(row.find('.received-qty').val()) || 0;
                const accepted = parseFloat(row.find('.accepted-qty').val()) || 0;
                let rejected = received - accepted;
                if(rejected < 0) rejected = 0;
                row.find('.rejected-qty').val(rejected.toFixed(2));
            }

            $('#btnAddItem').click(function () {
                var newRow = `
                    <tr>
                        <td>
                            <input name="GoodsReceiptNoteItems[${itemIndex}].Id" type="hidden" value="0" />
                            <select name="GoodsReceiptNoteItems[${itemIndex}].ItemId" class="form-select item-id-select" required>
                                <option value="">-- Select Item --</option>
                                @foreach(var item in (SelectList)ViewBag.ItemId)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                            <input type="hidden" name="GoodsReceiptNoteItems[${itemIndex}].ItemName" value="Item" />
                        </td>
                        <td>
                            <input name="GoodsReceiptNoteItems[${itemIndex}].ExpectedQuantity" class="form-control expected-qty" type="number" step="0.01" value="0.00" />
                        </td>
                        <td>
                            <input name="GoodsReceiptNoteItems[${itemIndex}].ReceivedQuantity" class="form-control received-qty calc-trigger" type="number" step="0.01" value="0.00" required />
                        </td>
                        <td>
                            <input name="GoodsReceiptNoteItems[${itemIndex}].AcceptedQuantity" class="form-control accepted-qty calc-trigger" type="number" step="0.01" value="0.00" required />
                        </td>
                        <td>
                            <input name="GoodsReceiptNoteItems[${itemIndex}].RejectedQuantity" class="form-control rejected-qty bg-light" type="number" step="0.01" value="0.00" readonly />
                        </td>
                        <td>
                            <input name="GoodsReceiptNoteItems[${itemIndex}].Remarks" class="form-control" />
                        </td>
                        <td class="text-center align-middle">
                            @if (ViewBag.POType == "Cylinder")
                            {
                                <button type="button" class="btn btn-outline-info btn-sm btn-details" data-type="Cylinder" data-index="${itemIndex}">
                                    <i class="bi bi-list-ul"></i> Cylinders
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-info btn-sm btn-details" data-type="Roll" data-index="${itemIndex}">
                                    <i class="bi bi-list-ul"></i> Rolls
                                </button>
                            }
                            <div class="item-details-container" id="details-container-${itemIndex}"></div>
                        </td>
                        <td class="text-center align-middle">
                            <button type="button" class="btn btn-outline-danger btn-sm remove-item" tabindex="-1">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                `;
                $('#itemsTable tbody').append(newRow);
                itemIndex++;
            });

            $(document).on('click', '.remove-item', function () {
                $(this).closest('tr').remove();
                
                // Re-index remaining rows
                $('#itemsTable tbody tr').each(function(index) {
                    $(this).find('input').each(function() {
                        var name = $(this).attr('name');
                        if (name) {
                            var newName = name.replace(/\[\d+\]/, '[' + index + ']');
                            $(this).attr('name', newName);
                        }
                    });
                });
                itemIndex = $('#itemsTable tbody tr').length;
            });
            
            $(document).on('input', '.calc-trigger', function() {
                calculateRejection($(this).closest('tr'));
            });

            $(document).on('change', '.item-id-select', function() {
                var selectedText = $(this).find("option:selected").text();
                $(this).closest('td').find('input[type="hidden"]').val(selectedText);
            });

            // Modals logic
            var poType = '@ViewBag.POType';
            
            $(document).on('click', '.btn-details', function() {
                var type = $(this).data('type');
                var index = $(this).data('index');
                var containerId = '#details-container-' + index;
                
                if (type === 'Roll') {
                    $('#currentRollItemIndex').val(index);
                    $('#rollsTable tbody').empty();
                    
                    var rollCount = 0;
                    $(containerId).find('input[name$=".RollNo"]').each(function() {
                        var no = $(this).val();
                        var weight = $(this).closest('.item-details-container').find('input[name="GoodsReceiptNoteItems[' + index + '].Rolls[' + rollCount + '].RollWeight"]').val();
                        
                        var tr = `<tr>
                            <td><input type="text" class="form-control roll-no" value="${no}" /></td>
                            <td><input type="number" step="0.01" class="form-control roll-weight" value="${weight}" /></td>
                            <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-modal-row"><i class="bi bi-x"></i></button></td>
                        </tr>`;
                        $('#rollsTable tbody').append(tr);
                        rollCount++;
                    });
                    
                    if(rollCount === 0) $('#btnAddRollRow').click();
                    
                    var rollsModal = new bootstrap.Modal(document.getElementById('rollsModal'));
                    rollsModal.show();
                } else if (type === 'Cylinder') {
                    $('#currentCylinderItemIndex').val(index);
                    $('#cylindersTable tbody').empty();
                    
                    var cylCount = 0;
                    $(containerId).find('input[name$=".CylinderNo"]').each(function() {
                        var no = $(this).val();
                        var tr = `<tr>
                            <td><input type="text" class="form-control cyl-no" value="${no}" /></td>
                            <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-modal-row"><i class="bi bi-x"></i></button></td>
                        </tr>`;
                        $('#cylindersTable tbody').append(tr);
                        cylCount++;
                    });
                    
                    if(cylCount === 0) $('#btnAddCylinderRow').click();
                    
                    var cylModal = new bootstrap.Modal(document.getElementById('cylindersModal'));
                    cylModal.show();
                }
            });

            $('#btnAddRollRow').click(function() {
                var tr = `<tr>
                    <td><input type="text" class="form-control roll-no" /></td>
                    <td><input type="number" step="0.01" class="form-control roll-weight" value="0" /></td>
                    <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-modal-row"><i class="bi bi-x"></i></button></td>
                </tr>`;
                $('#rollsTable tbody').append(tr);
            });

            $('#btnAddCylinderRow').click(function() {
                var tr = `<tr>
                    <td><input type="text" class="form-control cyl-no" /></td>
                    <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-modal-row"><i class="bi bi-x"></i></button></td>
                </tr>`;
                $('#cylindersTable tbody').append(tr);
            });

            $(document).on('click', '.remove-modal-row', function() {
                $(this).closest('tr').remove();
            });

            $('#btnSaveRolls').click(function() {
                var index = $('#currentRollItemIndex').val();
                var container = $('#details-container-' + index);
                container.empty();
                
                var rollCount = 0;
                $('#rollsTable tbody tr').each(function() {
                    var no = $(this).find('.roll-no').val();
                    var weight = $(this).find('.roll-weight').val();
                    if(no) {
                        var h1 = `<input type="hidden" name="GoodsReceiptNoteItems[${index}].Rolls[${rollCount}].RollNo" value="${no}" />`;
                        var h2 = `<input type="hidden" name="GoodsReceiptNoteItems[${index}].Rolls[${rollCount}].RollWeight" value="${weight}" />`;
                        container.append(h1).append(h2);
                        rollCount++;
                    }
                });
                
                bootstrap.Modal.getInstance(document.getElementById('rollsModal')).hide();
            });

            $('#btnSaveCylinders').click(function() {
                var index = $('#currentCylinderItemIndex').val();
                var container = $('#details-container-' + index);
                container.empty();
                
                var cylCount = 0;
                $('#cylindersTable tbody tr').each(function() {
                    var no = $(this).find('.cyl-no').val();
                    if(no) {
                        var h1 = `<input type="hidden" name="GoodsReceiptNoteItems[${index}].Cylinders[${cylCount}].CylinderNo" value="${no}" />`;
                        container.append(h1);
                        cylCount++;
                    }
                });
                
                bootstrap.Modal.getInstance(document.getElementById('cylindersModal')).hide();
            });
        });
    </script>
}
