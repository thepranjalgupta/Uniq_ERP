@model UniqPac_ERP.Models.GoodsReceiptNote

@{
    ViewData["Title"] = "Delete GRN";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Delete GRN</h2>
            <p class="text-danger mb-0">Are you sure you want to delete this Goods Receipt Note?</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Back to List</a>
    </div>

    <div class="card shadow-sm border-0 border-start border-danger border-4">
        <div class="card-body">
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">GRN Number</label>
                    <div class="fs-6">@Model.GRNNumber</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Date</label>
                    <div class="fs-6">@Model.GRNDate.ToString("dd-MM-yyyy")</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Vendor</label>
                    <div class="fs-6">@Model.Vendor?.Name</div>
                </div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger shadow-sm me-2">
                    <i class="bi bi-trash me-1"></i> Delete Goods Receipt Note
                </button>
                <a asp-action="Index" class="btn btn-light shadow-sm">Cancel</a>
            </form>
        </div>
    </div>
</div>
