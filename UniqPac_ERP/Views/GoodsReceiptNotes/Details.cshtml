@model UniqPac_ERP.Models.GoodsReceiptNote
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "GRN Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">GRN Details</h2>
            <p class="text-muted mb-0">@Model.GRNNumber</p>
        </div>
        <div>
            <a asp-action="Print" asp-route-id="@Model.Id" class="btn btn-secondary shadow-sm me-2" target="_blank">
                <i class="bi bi-printer me-1"></i> Print
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary shadow-sm me-2">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">Back to List</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 font-weight-bold text-primary">General Information</h6>
        </div>
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">GRN Number</label>
                    <div class="fs-6">@Model.GRNNumber</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">GRN Date</label>
                    <div class="fs-6">@Model.GRNDate.ToString("dd-MM-yyyy")</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Status</label>
                    <div class="fs-6">@Model.Status</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Approval Status</label>
                    <div class="fs-6"><span class="badge @(Model.ApprovalStatus == "Approved" ? "bg-success" : Model.ApprovalStatus == "Rejected" ? "bg-danger" : Model.ApprovalStatus == "Manager Approved" ? "bg-info" : "bg-warning text-dark")">@Model.ApprovalStatus</span></div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Purchase Order</label>
                    <div class="fs-6">@(Model.PurchaseOrder?.PONumber ?? "-")</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Vendor</label>
                    <div class="fs-6">@Model.Vendor?.Name</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Challan / Invoice No</label>
                    <div class="fs-6">@Model.ChallanNumber</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Challan Date</label>
                    <div class="fs-6">@(Model.ChallanDate?.ToString("dd-MM-yyyy") ?? "-")</div>
                </div>
                <div class="col-md-3">
                    <label class="text-muted small fw-bold text-uppercase">Vehicle Number</label>
                    <div class="fs-6">@Model.VehicleNumber</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            @if (Model.ApprovalStatus == "Pending" && (await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Manager)).Succeeded)
            {
                <form asp-action="ApproveManager" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-info">Approve (Manager)</button>
                </form>
            }
            
            @if (Model.ApprovalStatus != "Approved" && Model.ApprovalStatus != "Rejected" && (await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Admin)).Succeeded)
            {
                <form asp-action="ApproveAdmin" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-success">Approve (Admin)</button>
                </form>
            }

            @if (Model.ApprovalStatus != "Approved" && Model.ApprovalStatus != "Rejected" && ((await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Manager)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Admin)).Succeeded))
            {
                <form asp-action="Reject" method="post" class="d-inline ms-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="input-group input-group-sm d-inline-flex" style="width: auto;">
                        <input type="text" name="reason" class="form-control" placeholder="Rejection reason" required />
                        <button type="submit" class="btn btn-danger">Reject</button>
                    </div>
                </form>
            }

            @if (Model.ApprovalStatus == "Rejected")
            {
                <form asp-action="Resubmit" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="input-group input-group-sm d-inline-flex" style="width: auto;">
                        <input type="text" name="remarks" class="form-control" placeholder="Resubmission remarks" />
                        <button type="submit" class="btn btn-warning">Resubmit</button>
                    </div>
                </form>
            }
        </div>
    </div>
    
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 font-weight-bold text-primary">Approval History</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Action</th>
                            <th>Action By</th>
                            <th>Date</th>
                            <th class="pe-4">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ApprovalHistories != null)
                        {
                            foreach (UniqPac_ERP.Models.ApprovalHistory history in ViewBag.ApprovalHistories)
                            {
                                <tr>
                                    <td class="ps-4">@history.Action</td>
                                    <td>@(history.ActionBy?.FirstName) @(history.ActionBy?.LastName)</td>
                                    <td>@history.ActionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="pe-4">@history.Remarks</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="m-0 font-weight-bold text-primary">Received Items</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Item Name</th>
                            <th>Expected Qty</th>
                            <th>Received Qty</th>
                            <th>Accepted Qty</th>
                            <th>Rejected Qty</th>
                            <th class="pe-4">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.GoodsReceiptNoteItems)
                        {
                            <tr>
                                <td class="ps-4 fw-medium">@item.ItemName</td>
                                <td>@item.ExpectedQuantity</td>
                                <td>@item.ReceivedQuantity</td>
                                <td>@item.AcceptedQuantity</td>
                                <td>@item.RejectedQuantity</td>
                                <td class="pe-4">@item.Remarks</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Remarks))
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 font-weight-bold text-primary">General Remarks</h6>
            </div>
            <div class="card-body">
                @Model.Remarks
            </div>
        </div>
    }
</div>
