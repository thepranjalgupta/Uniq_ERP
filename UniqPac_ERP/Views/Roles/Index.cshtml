
@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark mb-0">Role Management</h3>
    <button class="btn btn-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#createRoleModal">
        <i class="ph ph-plus me-1"></i> Create Role
    </button>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 fw-semibold text-secondary">Role Name</th>
                        <th class="text-end pe-4 fw-semibold text-secondary">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-medium">@item.Name</td>
                            <td class="text-end pe-4">
                                <a asp-action="ManagePermissions" asp-route-roleId="@item.Id" class="btn btn-sm btn-light border me-2">
                                    <i class="ph ph-shield-check text-primary"></i> Permissions
                                </a>
                                @if(item.Name != "Admin"){
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-danger" onclick="return confirm('Delete this role?');">
                                        <i class="ph ph-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createRoleModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom-0">
        <h5 class="modal-title fw-bold">Create New Role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form asp-action="Create">
          <div class="modal-body">
            <label class="form-label fw-semibold">Role Name</label>
            <input type="text" name="roleName" class="form-control" required />
          </div>
          <div class="modal-footer border-top-0">
            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Create</button>
          </div>
      </form>
    </div>
  </div>
</div>
