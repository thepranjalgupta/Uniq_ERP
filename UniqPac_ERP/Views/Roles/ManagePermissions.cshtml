
@model UniqPac_ERP.ViewModels.ManagePermissionsViewModel
@{
    ViewData["Title"] = "Manage Permissions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-0">Manage Permissions</h3>
        <p class="text-muted mb-0">Role: <span class="fw-bold text-primary">@Model.RoleName</span></p>
    </div>
    <a asp-action="Index" class="btn btn-light border">Back to Roles</a>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        <form asp-action="ManagePermissions">
            <input type="hidden" asp-for="RoleId" />
            
            <div class="row g-4 mb-4">
                @{
                    var grouped = Model.RoleClaims.GroupBy(c => c.Value.Split('.')[1]).ToList();
                }
                @for (int i = 0; i < Model.RoleClaims.Count; i++)
                {
                    <input type="hidden" asp-for="RoleClaims[i].Type" />
                    <input type="hidden" asp-for="RoleClaims[i].Value" />
                }

                @foreach (var group in grouped)
                {
                    <div class="col-md-4">
                        <div class="p-3 border rounded-3 bg-light h-100">
                            <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">@group.Key</h6>
                            @foreach (var claim in group)
                            {
                                var index = Model.RoleClaims.IndexOf(claim);
                                var actionName = claim.Value.Split('.').Last();
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" asp-for="@Model.RoleClaims[index].Selected">
                                    <label class="form-check-label ms-2" asp-for="@Model.RoleClaims[index].Selected">
                                        @actionName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <div class="border-top pt-4">
                <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Permissions</button>
            </div>
        </form>
    </div>
</div>
