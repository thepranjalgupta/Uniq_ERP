@model UniqPac_ERP.Models.CustomerJob

@{
    ViewData["Title"] = "Edit Customer Job";
}

<div class="card shadow-sm" style="max-width: 800px; margin: 0 auto;">
    <div class="card-header bg-primary text-white" style="border-radius: calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px) 0 0;">
        <h4 class="mb-0 text-white fw-bold">Edit Customer Job</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="row mb-4">
                <div class="col-12">
                    <label asp-for="CustomerId" class="form-label fw-bold">Customer <span class="text-danger">*</span></label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
                    <span asp-validation-for="CustomerId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <label asp-for="JobName" class="form-label fw-bold">Job Title <span class="text-danger">*</span></label>
                    <input asp-for="JobName" class="form-control" />
                    <span asp-validation-for="JobName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3">
                    <label asp-for="Substrate" class="form-label fw-bold"></label>
                    <input asp-for="Substrate" class="form-control" />
                    <span asp-validation-for="Substrate" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="SurfaceOrReverse" class="form-label fw-bold"></label>
                    <input asp-for="SurfaceOrReverse" class="form-control" />
                    <span asp-validation-for="SurfaceOrReverse" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Width" class="form-label fw-bold"></label>
                    <input asp-for="Width" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Width" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Length" class="form-label fw-bold"></label>
                    <input asp-for="Length" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Length" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Thickness" class="form-label fw-bold"></label>
                    <input asp-for="Thickness" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Thickness" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <label asp-for="ColorCount" class="form-label fw-bold"></label>
                    <input asp-for="ColorCount" class="form-control" type="number" />
                    <span asp-validation-for="ColorCount" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Finish" class="form-label fw-bold"></label>
                    <input asp-for="Finish" class="form-control" />
                    <span asp-validation-for="Finish" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PackingType" class="form-label fw-bold"></label>
                    <input asp-for="PackingType" class="form-control" />
                    <span asp-validation-for="PackingType" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-12">
                    <label asp-for="SpecialInstructions" class="form-label fw-bold"></label>
                    <textarea asp-for="SpecialInstructions" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="SpecialInstructions" class="text-danger"></span>
                </div>
            </div>

            <!-- PDF Specific Fields -->
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">Additional details</h5>
            <div class="row mb-4 bg-light p-3 rounded mx-0">
                <div class="col-md-12 mb-3">
                    <label class="form-label fw-bold">Artwork Image</label>
                    @if (!string.IsNullOrEmpty(Model.ArtworkImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ArtworkImagePath" alt="Artwork" style="max-height: 150px; border: 1px solid #ccc; padding: 3px;" />
                        </div>
                    }
                    <input type="file" name="ArtworkImage" class="form-control" accept="image/*" />
                    <small class="text-muted">Upload a new image to replace the current artwork.</small>
                    <input type="hidden" asp-for="ArtworkImagePath" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="JobCode" class="form-label fw-bold"></label>
                    <input asp-for="JobCode" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Specs" class="form-label fw-bold"></label>
                    <input asp-for="Specs" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="CylinderStatus" class="form-label fw-bold"></label>
                    <input asp-for="CylinderStatus" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="CylinderCharges" class="form-label fw-bold"></label>
                    <input asp-for="CylinderCharges" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="RollWeight" class="form-label fw-bold"></label>
                    <input asp-for="RollWeight" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Direction" class="form-label fw-bold"></label>
                    <input asp-for="Direction" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="ShadeMatch" class="form-label fw-bold"></label>
                    <input asp-for="ShadeMatch" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="SampleRequired" class="form-label fw-bold"></label>
                    <input asp-for="SampleRequired" class="form-control form-control-sm" />
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label fw-bold" asp-for="IsActive">
                            @Html.DisplayNameFor(model => model.IsActive)
                        </label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsDeleted" />
                        <label class="form-check-label fw-bold" asp-for="IsDeleted">
                            @Html.DisplayNameFor(model => model.IsDeleted)
                        </label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                    <a asp-action="Index" class="btn btn-light px-4 ms-2 border">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
