
@model IEnumerable<UniqPac_ERP.Models.ApplicationUser>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark mb-0">User Management</h3>
    <a asp-action="Create" class="btn btn-primary fw-semibold">
        <i class="ph ph-plus me-1"></i> Create User
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 fw-semibold text-secondary">Name</th>
                        <th class="fw-semibold text-secondary">Email</th>
                        <th class="fw-semibold text-secondary">Emp Code</th>
                        <th class="fw-semibold text-secondary">Dept</th>
                        <th class="fw-semibold text-secondary">Status</th>
                        <th class="text-end pe-4 fw-semibold text-secondary">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-medium">@item.FirstName @item.LastName</td>
                            <td>@item.Email</td>
                            <td>@item.EmployeeCode</td>
                            <td>@item.Department</td>
                            <td>
                                @if(item.IsActive){
                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">Active</span>
                                } else {
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1 rounded-pill">Inactive</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light border me-1">
                                    <i class="ph ph-pencil-simple"></i>
                                </a>
                                @if(item.Email != "admin@uniq.com"){
                                    <a asp-action="ToggleStatus" asp-route-id="@item.Id" class="btn btn-sm btn-light border @(item.IsActive ? "text-danger" : "text-success")" title="Toggle Status">
                                        <i class="ph @(item.IsActive ? "ph-lock-key" : "ph-lock-key-open")"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
