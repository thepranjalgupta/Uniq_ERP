@model UniqPac_ERP.Models.StockLedger

@{
    ViewData["Title"] = "Manual Stock Adjustment";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Stock Adjustment</h2>
            <p class="text-muted mb-0">Manually adjust inventory levels (e.g. for physical counts)</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Stock
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="mb-3">
                            <label asp-for="ItemId" class="form-label fw-bold"></label>
                            <select asp-for="ItemId" class="form-select" asp-items="ViewBag.ItemId" required>
                                <option value="">-- Select Item --</option>
                            </select>
                            <span asp-validation-for="ItemId" class="text-danger"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="TransactionDate" class="form-label fw-bold"></label>
                                <input asp-for="TransactionDate" class="form-control" type="date" required />
                                <span asp-validation-for="TransactionDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label fw-bold">Adjustment Quantity</label>
                                <div class="input-group">
                                    <input asp-for="Quantity" class="form-control" type="number" step="0.01" required />
                                </div>
                                <div class="form-text">Use positive numbers to add stock, negative to reduce.</div>
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ReferenceNumber" class="form-label fw-bold">Reference (Optional)</label>
                            <input asp-for="ReferenceNumber" class="form-control" placeholder="e.g. Physical Count Q3" />
                            <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Remarks" class="form-label fw-bold">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Reason for adjustment..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">Apply Adjustment</button>
                            <a asp-action="Index" class="btn btn-light border shadow-sm">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="alert alert-info border-0 shadow-sm">
                <h5 class="alert-heading"><i class="bi bi-info-circle-fill me-2"></i> How Adjustments Work</h5>
                <hr>
                <p>A manual stock adjustment will immediately change the <strong>Current Stock</strong> of the selected item and create an entry in its <strong>Stock Ledger</strong>.</p>
                <ul>
                    <li>To <strong>increase</strong> stock (e.g., found unrecorded items), enter a positive number (e.g., <code>50</code>).</li>
                    <li>To <strong>decrease</strong> stock (e.g., damaged items, theft), enter a negative number (e.g., <code>-10</code>).</li>
                </ul>
                <p class="mb-0 text-muted small">All manual adjustments are permanently recorded with your user name and timestamp.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
