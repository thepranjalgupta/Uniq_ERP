@model IEnumerable<UniqPac_ERP.Models.GoodsReceiptNoteRoll>

@{
    ViewData["Title"] = "Rolls List";
    var item = ViewBag.Item as UniqPac_ERP.Models.Item;
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Rolls List</h2>
            <p class="text-muted mb-0">Rolls stock for @item?.ItemName</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Stock
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 py-2 border-start border-primary border-4">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Item Code</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@item?.ItemCode</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-upc fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100 py-2 border-start border-success border-4">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total Rolls</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="bi bi-vinyl fs-2 text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>GRN NO</th>
                            <th>DATE RECEIVED</th>
                            <th>ROLL NO</th>
                            <th>ROLL WEIGHT (KG)</th>
                            <th>STATUS</th>
                            <th>DISPATCH TO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var itemRow in Model)
                        {
                            <tr>
                                <td>
                                    <a href="/GoodsReceiptNotes/Details/@itemRow.GoodsReceiptNoteItem?.GoodsReceiptNoteId" class="text-decoration-none fw-medium">
                                        @(itemRow.GoodsReceiptNoteItem?.GoodsReceiptNote?.GRNNumber ?? "-")
                                    </a>
                                </td>
                                <td>@(itemRow.GoodsReceiptNoteItem?.GoodsReceiptNote?.GRNDate.ToString("dd MMM yyyy") ?? "-")</td>
                                <td class="fw-bold">@itemRow.RollNo</td>
                                <td class="fw-bold">@itemRow.RollWeight.ToString("N2")</td>
                                <td>
                                    @if (itemRow.IsDispatched)
                                    {
                                        <span class="badge bg-warning text-dark">Dispatched</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">In Stock</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(itemRow.DispatchedTo))
                                    {
                                        <span>@itemRow.DispatchedTo</span>
                                    }
                                    else if (itemRow.IsDispatched && itemRow.DispatchItemRolls.Any())
                                    {
                                        var lastDispatch = itemRow.DispatchItemRolls.OrderByDescending(d => d.Id).FirstOrDefault()?.DispatchItem?.Dispatch;
                                        if (lastDispatch != null)
                                        {
                                            if (lastDispatch.CustomerId.HasValue)
                                            {
                                                <span>@lastDispatch.Customer?.Name</span>
                                            }
                                            else if (lastDispatch.VendorId.HasValue)
                                            {
                                                <span>@lastDispatch.Vendor?.Name</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                            </tr>
                        }
                        
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-vinyl fs-2 d-block mb-2"></i>
                                    No rolls found for this item.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
