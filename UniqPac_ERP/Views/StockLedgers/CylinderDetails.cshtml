@model IEnumerable<UniqPac_ERP.Models.CylinderStockLedger>

@{
    var cylinder = ViewBag.Cylinder as UniqPac_ERP.Models.CylinderMaster;
    ViewData["Title"] = $"Stock Ledger - {cylinder?.CylinderName}";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Cylinder Stock Ledger</h2>
            <p class="text-muted mb-0">Transaction history for @cylinder?.CylinderName</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CylinderIndex" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Stock Balance
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small text-uppercase fw-bold mb-1">Current Stock</div>
                            <div class="h2 mb-0 fw-bold">@cylinder?.CurrentStock.ToString("0.##")</div>
                        </div>
                        <div class="fs-1 text-white-50">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-9 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-primary mb-3">Cylinder Information</h5>
                    <div class="row">
                        <div class="col-sm-4 mb-2">
                            <small class="text-muted d-block">Cylinder Code</small>
                            <strong>@cylinder?.CylinderCode</strong>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <small class="text-muted d-block">Job</small>
                            <strong>@(cylinder?.CustomerJob?.JobName ?? "-")</strong>
                        </div>
                        <div class="col-sm-4 mb-2">
                            <small class="text-muted d-block">Product Packed</small>
                            <strong>@(cylinder?.ProductPacked ?? "-")</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-gray-800">Transaction History</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="ledgerTable">
                    <thead class="bg-light">
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Reference</th>
                            <th class="text-end">Quantity IN</th>
                            <th class="text-end">Quantity OUT</th>
                            <th class="text-end">Running Balance</th>
                            <th>Remarks</th>
                            <th>User</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.TransactionDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary rounded-pill">@item.TransactionType</span>
                                </td>
                                <td><span class="fw-medium text-primary">@item.ReferenceNumber</span></td>
                                <td class="text-end text-success fw-bold">
                                    @(item.Quantity > 0 ? $"+{item.Quantity:0.##}" : "-")
                                </td>
                                <td class="text-end text-danger fw-bold">
                                    @(item.Quantity < 0 ? $"{item.Quantity:0.##}" : "-")
                                </td>
                                <td class="text-end fw-bold">@item.RunningBalance.ToString("0.##")</td>
                                <td><small class="text-muted">@item.Remarks</small></td>
                                <td><small>@item.CreatedBy</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="text-center p-5 text-muted">
                    <i class="bi bi-clock-history display-4 mb-3 d-block opacity-50"></i>
                    <p class="mb-0">No transaction history found for this cylinder.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ledgerTable').DataTable({
                "order": [[0, "desc"]],
                "pageLength": 25,
                "language": {
                    "search": "",
                    "searchPlaceholder": "Search transactions..."
                }
            });
            $('.dataTables_filter input').addClass('form-control form-control-sm');
            $('.dataTables_length select').addClass('form-select form-select-sm');
        });
    </script>
}
