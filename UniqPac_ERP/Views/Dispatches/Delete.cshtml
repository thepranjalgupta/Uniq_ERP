@model UniqPac_ERP.Models.Dispatch

@{
    ViewData["Title"] = "Delete Dispatch";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Delete Dispatch</h2>
            <p class="text-muted mb-0">Are you sure you want to delete this Delivery Note?</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="alert alert-danger shadow-sm border-0 mb-4">
        <h4 class="alert-heading"><i class="bi bi-exclamation-triangle-fill me-2"></i> Warning!</h4>
        <p>You are about to delete Delivery Note <strong>@Model.DispatchNumber</strong>. This action cannot be undone.</p>
        <hr>
        <p class="mb-0">Deleting this dispatch will revert the dispatched quantities for the related Sales Order, which may change its status back to Pending or Partially Dispatched.</p>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted mb-1">DN Number</label>
                    <div>@Model.DispatchNumber</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted mb-1">Dispatch Date</label>
                    <div>@Model.DispatchDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted mb-1">Sales Order</label>
                    <div>
                        <span class="badge bg-secondary">@Model.SalesOrder?.OrderNo</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted mb-1">Customer</label>
                    <div>@Model.Customer?.Name</div>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger px-4 shadow-sm">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-light border shadow-sm ms-2">Cancel</a>
    </form>
</div>
