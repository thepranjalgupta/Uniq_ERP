@model IEnumerable<UniqPac_ERP.Models.Dispatch>
@using Microsoft.AspNetCore.Authorization
@using UniqPac_ERP.Constants
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Dispatches";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800">Dispatches</h2>
            <p class="text-muted mb-0">Manage Delivery Notes</p>
        </div>
        
        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.Dispatches.Create)).Succeeded)
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create Dispatch
            </a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="px-4 py-3">DN Number</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Sales Order</th>
                            <th class="py-3">Customer</th>
                            <th class="py-3">LR Number</th>
                            <th class="py-3 text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-medium">@Html.DisplayFor(modelItem => item.DispatchNumber)</td>
                                <td>@item.DispatchDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary">@item.SalesOrder?.OrderNo</span>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Customer!.Name)
                                </td>
                                <td>
                                    @(string.IsNullOrEmpty(item.LRNumber) ? "-" : item.LRNumber)
                                </td>
                                <td class="text-end px-4">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Print" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" target="_blank" title="Print DN">
                                            <i class="bi bi-printer"></i>
                                        </a>
                                        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.Dispatches.Edit)).Succeeded)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if ((await AuthorizationService.AuthorizeAsync(User, Permissions.Dispatches.Delete)).Succeeded)
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No dispatches found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
