@model UniqPac_ERP.Models.Dispatch

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Delivery Note - @Model.DispatchNumber</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            font-size: 12px;
            color: #333;
        }
        .container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            border: 1px solid #000;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #000;
            padding: 15px;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            color: #000;
            text-transform: uppercase;
        }
        .header h2 {
            margin: 5px 0 0 0;
            font-size: 16px;
            font-weight: bold;
        }
        .header p {
            margin: 5px 0 0 0;
            font-size: 12px;
        }
        .info-grid {
            display: flex;
            border-bottom: 2px solid #000;
        }
        .info-box {
            flex: 1;
            padding: 10px;
        }
        .info-box:first-child {
            border-right: 2px solid #000;
        }
        .info-box h3 {
            margin: 0 0 10px 0;
            font-size: 13px;
            text-transform: uppercase;
            text-decoration: underline;
        }
        .info-row {
            display: flex;
            margin-bottom: 5px;
        }
        .info-label {
            font-weight: bold;
            width: 130px;
        }
        .info-value {
            flex: 1;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }
        th, td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f0f0f0;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 11px;
            text-align: center;
        }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .footer-grid {
            display: flex;
            border-top: 2px solid #000;
        }
        .remarks-box {
            flex: 60%;
            padding: 10px;
            border-right: 2px solid #000;
            min-height: 80px;
        }
        .signature-box {
            flex: 40%;
            padding: 10px;
            position: relative;
        }
        .signature-line {
            position: absolute;
            bottom: 10px;
            right: 10px;
            left: 10px;
            text-align: right;
            font-weight: bold;
        }
        @@media print {
            body { padding: 0; }
            .container { border: 1px solid #000; padding: 0; }
        }
    </style>
</head>
<body onload="window.print()">
    <div class="container">
        <div class="header">
            <h1>DELIVERY NOTE / CHALLAN</h1>
            <h2>UNIQUE PACKTECH</h2>
            <p>123 Industrial Area, Phase 1, City, State - 123456</p>
        </div>

        <div class="info-grid">
            <div class="info-box">
                <h3>Consignee Details (Billed To)</h3>
                @if (Model.CustomerId.HasValue)
                {
                    <strong>@Model.Customer?.Name (Customer)</strong><br/>
                    @if(!string.IsNullOrEmpty(Model.Customer?.BillingAddress)) { <span>@Model.Customer.BillingAddress<br/></span> }
                    @if(!string.IsNullOrEmpty(Model.Customer?.City)) { <span>@Model.Customer.City, @Model.Customer.State - @Model.Customer.ZipCode<br/></span> }
                    @if(!string.IsNullOrEmpty(Model.Customer?.GSTNo)) { <span>GSTIN: @Model.Customer.GSTNo<br/></span> }
                }
                else
                {
                    <strong>@Model.Vendor?.Name (Vendor)</strong><br/>
                    @if(!string.IsNullOrEmpty(Model.Vendor?.Address)) { <span>@Model.Vendor.Address<br/></span> }
                    @if(!string.IsNullOrEmpty(Model.Vendor?.City)) { <span>@Model.Vendor.City, @Model.Vendor.State - @Model.Vendor.ZipCode<br/></span> }
                    @if(!string.IsNullOrEmpty(Model.Vendor?.GSTNo)) { <span>GSTIN: @Model.Vendor.GSTNo<br/></span> }
                }
            </div>
            
            <div class="info-box">
                <div class="info-row">
                    <div class="info-label">DN / Challan No:</div>
                    <div class="info-value"><strong>@Model.DispatchNumber</strong></div>
                </div>
                <div class="info-row">
                    <div class="info-label">Date:</div>
                    <div class="info-value">@Model.DispatchDate.ToString("dd-MM-yyyy")</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Your Order Ref:</div>
                    <div class="info-value">@(Model.SalesOrderId > 0 ? Model.SalesOrder?.OrderNo : "Ad-Hoc")</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Transport Mode:</div>
                    <div class="info-value">@Model.TransportMode</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Transporter:</div>
                    <div class="info-value">@Model.TransporterName</div>
                </div>
                <div class="info-row">
                    <div class="info-label">LR No:</div>
                    <div class="info-value">@Model.LRNumber</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Vehicle No:</div>
                    <div class="info-value">@Model.VehicleNumber</div>
                </div>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width: 5%; border-left: none;">S.No</th>
                    <th style="width: 65%;">Description of Goods / Job Name</th>
                    @if (Model.SalesOrderId > 0)
                    {
                        <th style="width: 15%;">Order Qty</th>
                    }
                    <th style="width: 15%; border-right: none;">Dispatch Qty</th>
                </tr>
            </thead>
            <tbody>
                @{ int sn = 1; }
                @foreach (var item in Model.DispatchItems)
                {
                    <tr>
                        <td class="text-center" style="border-left: none;">@(sn++)</td>
                        <td>@item.ItemName</td>
                        @if (Model.SalesOrderId > 0)
                        {
                            <td class="text-right">@item.OrderedQuantity</td>
                        }
                        <td class="text-right fw-bold" style="border-right: none;"><strong>@item.DispatchedQuantity</strong></td>
                    </tr>
                }
                @if (!Model.DispatchItems.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center" style="border-left: none; border-right: none;">No items found.</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="footer-grid">
            <div class="remarks-box">
                <strong>Remarks:</strong><br />
                @Model.Remarks
            </div>
            <div class="signature-box">
                <div style="height: 60px;"></div>
                <div class="signature-line">For UNIQUE PACKTECH</div>
            </div>
        </div>
    </div>
</body>
</html>
