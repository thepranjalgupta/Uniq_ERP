@model UniqPac_ERP.Models.PurchaseOrder
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = $"{(Model.POType)} PO Details";
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0 text-gray-800 fw-bold">PO Details</h2>
        <div>
            <a asp-action="Print" asp-route-id="@Model?.Id" target="_blank" class="btn btn-outline-success me-2 shadow-sm">
                <i class="bi bi-printer me-1"></i> Print PO
            </a>
            @if (Model.ApprovalStatus != "Approved")
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary me-2 shadow-sm">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            }
            <a asp-action="Index" asp-route-type="@Model.POType" class="btn btn-light border shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom-0">
            <h6 class="m-0 font-weight-bold text-primary">@Model!.PONumber</h6>
        </div>
        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-4">
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Vendor</h6>
                    <p class="fw-bold fs-5">@Model.Vendor.Name</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Date</h6>
                    <p class="fw-bold">@Model.PODate.ToString("dd/MM/yyyy")</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Status</h6>
                    <p class="fw-bold">
                        <span class="badge bg-primary">@Model.Status</span>
                    </p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Approval Status</h6>
                    <p class="fw-bold">
                        <span class="badge @(Model.ApprovalStatus == "Approved" ? "bg-success" : Model.ApprovalStatus == "Rejected" ? "bg-danger" : Model.ApprovalStatus == "Manager Approved" ? "bg-info" : "bg-warning text-dark")">@Model.ApprovalStatus</span>
                    </p>
                </div>
            </div>

            <div class="mb-4">
                @if (Model.ApprovalStatus == "Pending" && (await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Manager)).Succeeded)
                {
                    <form asp-action="ApproveManager" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-info">Approve (Manager)</button>
                    </form>
                }
                
                @if (Model.ApprovalStatus != "Approved" && Model.ApprovalStatus != "Rejected" && (await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Admin)).Succeeded)
                {
                    <form asp-action="ApproveAdmin" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-success">Approve (Admin)</button>
                    </form>
                }

                @if (Model.ApprovalStatus != "Approved" && Model.ApprovalStatus != "Rejected" && ((await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Manager)).Succeeded || (await AuthorizationService.AuthorizeAsync(User, UniqPac_ERP.Constants.Permissions.Approvals.Admin)).Succeeded))
                {
                    <form asp-action="Reject" method="post" class="d-inline ms-2">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group input-group-sm d-inline-flex" style="width: auto;">
                            <input type="text" name="reason" class="form-control" placeholder="Rejection reason" required />
                            <button type="submit" class="btn btn-danger">Reject</button>
                        </div>
                    </form>
                }

                @if (Model.ApprovalStatus == "Rejected")
                {
                    <form asp-action="Resubmit" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group input-group-sm d-inline-flex" style="width: auto;">
                            <input type="text" name="remarks" class="form-control" placeholder="Resubmission remarks" />
                            <button type="submit" class="btn btn-warning">Resubmit</button>
                        </div>
                    </form>
                }
            </div>

            <h5 class="fw-bold mb-3 mt-4 border-bottom pb-2">Approval History</h5>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Action</th>
                            <th>Action By</th>
                            <th>Date</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ApprovalHistories != null)
                        {
                            foreach (UniqPac_ERP.Models.ApprovalHistory history in ViewBag.ApprovalHistories)
                            {
                                <tr>
                                    <td>@history.Action</td>
                                    <td>@(history.ActionBy?.FirstName) @(history.ActionBy?.LastName)</td>
                                    <td>@history.ActionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@history.Remarks</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <h5 class="fw-bold mb-3 mt-4 border-bottom pb-2">Line Items</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product/Job Name</th>
                            @if (Model.POType == "Cylinder")
                            {
                                <th>Job Size</th>
                                <th>Cylinder Size</th>
                                <th class="text-end">No. of Cyl</th>
                            }
                            else
                            {
                                <th>Pouch/Roll Type</th>
                                <th class="text-end">Qty</th>
                            }
                            <th class="text-end">Price (₹)</th>
                            <th class="text-end fw-bold">Line Total (₹)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PurchaseOrderItems != null && Model.PurchaseOrderItems.Any())
                        {
                            foreach (var item in Model.PurchaseOrderItems)
                            {
                                <tr>
                                    <td>@item.ProductJobName</td>
                                    @if (Model.POType == "Cylinder")
                                    {
                                        <td>@item.JobSize</td>
                                        <td>@item.CylinderSize</td>
                                        <td class="text-end">@item.NumberOfCylinders</td>
                                    }
                                    else
                                    {
                                        <td>@item.PouchRollType</td>
                                        <td class="text-end">@item.Quantity</td>
                                    }
                                    <td class="text-end">@item.Price.ToString("N2")</td>
                                    <td class="text-end fw-bold">@item.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(Model.POType == "Cylinder" ? 6 : 5)" class="text-center text-muted py-3">No items found.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="@(Model.POType == "Cylinder" ? 5 : 4)" class="text-end fw-bold">Grand Total:</td>
                            <td class="text-end fw-bold fs-5 text-primary">₹@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <h5 class="fw-bold mb-3 mt-4 border-bottom pb-2">Specifications</h5>
            <div class="row">
                <div class="col-md-3 mb-2"><strong>Surface or Reverse:</strong> @Model.SurfaceOrReverse</div>
                <div class="col-md-3 mb-2"><strong>Structure:</strong> @Model.Structure</div>
                <div class="col-md-3 mb-2"><strong>Product Packed:</strong> @Model.ProductPacked</div>
                <div class="col-md-3 mb-2"><strong>Pet Size:</strong> @Model.PetSize</div>
                @if (Model.POType == "Cylinder")
                {
                    <div class="col-md-3 mb-2"><strong>Coil Size:</strong> @Model.CoilSize</div>
                    <div class="col-md-3 mb-2"><strong>Repeat Size:</strong> @Model.RepeatSize</div>
                    <div class="col-md-3 mb-2"><strong>Dispatch Schedule:</strong> @Model.DispatchSchedule</div>
                    <div class="col-md-3 mb-2"><strong>Bore ID:</strong> @Model.BoreId</div>
                }
                else
                {
                    <div class="col-md-3 mb-2"><strong>Coil / Repeat Size:</strong> @Model.CoilSizeRepeatSize</div>
                    <div class="col-md-3 mb-2"><strong>Cylinder Size:</strong> @Model.CylinderSize</div>
                    <div class="col-md-3 mb-2"><strong>Unwind Direction:</strong> @Model.UnwindDirection</div>
                    <div class="col-md-3 mb-2"><strong>Roll Weight:</strong> @Model.RollWeight</div>
                    <div class="col-md-3 mb-2"><strong>Packing Type:</strong> @Model.PackingType</div>
                    <div class="col-md-3 mb-2"><strong>Dispatch Schedule:</strong> @Model.DispatchSchedule</div>
                    <div class="col-md-3 mb-2"><strong>Color Reference:</strong> @Model.ColorReference</div>
                    <div class="col-md-3 mb-2"><strong>Window Maker:</strong> @Model.WindowMaker</div>
                    <div class="col-md-3 mb-2"><strong>Cylinder Maker:</strong> @Model.CylinderMaker</div>
                }
                <div class="col-md-12 mb-2"><strong>Remarks:</strong> @Model.Remarks</div>
            </div>
        </div>
    </div>
</div>
