@model IEnumerable<UniqPac_ERP.Models.Item>

@{
    ViewData["Title"] = "Manage Items";
}

<div class="card">
<div class="card-header">
<h4 class="mb-0">Records</h4>
<a asp-action="Create" class="btn btn-primary"><i class="ph ph-plus"></i> Create New</a>
</div>
<div class="card-body p-0">
<div class="table-responsive">
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ItemCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ItemCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UOM)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ItemType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MinStockLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReorderQty)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ItemCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ItemCategory.CategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UOM.UomName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ItemType.TypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MinStockLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReorderQty)
            </td>
            <td>
                <a asp-action="Edit" class="btn btn-sm btn-light" asp-route-id="@item.Id">Edit</a>
                <a asp-action="Details" class="btn btn-sm btn-light me-1" asp-route-id="@item.Id">Details</a>
                <a asp-action="Delete" class="btn btn-sm btn-danger" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

</div>
</div>
</div>