@model UniqPac_ERP.Models.Item

@{
    ViewData["Title"] = "Create Item";
}

<div class="card shadow-sm border-0" style="max-width: 900px; margin: 0 auto;">
    <div class="card-header bg-white border-bottom p-4">
        <h4 class="mb-1 fw-bold text-dark">Add Item</h4>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Register a new inventory item, raw material, or finished good.</p>
    </div>
    <div class="card-body p-4 p-md-5">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

            <!-- Basic Information Group -->
            <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom" style="font-size: 1.1rem;">Basic Information</h5>
            <div class="row mb-4">
                <div class="col-md-6 mb-3 mb-md-0">
                    <label asp-for="ItemCode" class="form-label fw-semibold text-secondary">Item Code <span class="text-danger">*</span></label>
                    <input asp-for="ItemCode" class="form-control" placeholder="ITM0004" />
                    <span asp-validation-for="ItemCode" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ItemName" class="form-label fw-semibold text-secondary">Item Name <span class="text-danger">*</span></label>
                    <input asp-for="ItemName" class="form-control" />
                    <span asp-validation-for="ItemName" class="text-danger"></span>
                </div>
                <div class="col-12 mt-3">
                    <label asp-for="Description" class="form-label fw-semibold text-secondary">Description <span class="fw-normal text-muted">(Optional)</span></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <!-- Classification Group -->
            <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom mt-5" style="font-size: 1.1rem;">Classification</h5>
            <div class="row mb-4">
                <div class="col-md-4 mb-3 mb-md-0">
                    <label asp-for="ItemCategoryId" class="form-label fw-semibold text-secondary">Category <span class="text-danger">*</span></label>
                    <select asp-for="ItemCategoryId" class="form-select" asp-items="ViewBag.ItemCategoryId">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="ItemCategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <label asp-for="UomId" class="form-label fw-semibold text-secondary">Unit of Measure <span class="text-danger">*</span></label>
                    <select asp-for="UomId" class="form-select" asp-items="ViewBag.UomId">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="UomId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ItemTypeId" class="form-label fw-semibold text-secondary">Item Type <span class="text-danger">*</span></label>
                    <select asp-for="ItemTypeId" class="form-select" asp-items="ViewBag.ItemTypeId">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="ItemTypeId" class="text-danger"></span>
                </div>
            </div>

            <!-- Inventory & Costing Group -->
            <h5 class="fw-bold mb-3 pb-2 text-dark border-bottom mt-5" style="font-size: 1.1rem;">Inventory & Costing</h5>
            <div class="row mb-5">
                <div class="col-md-4 mb-3 mb-md-0">
                    <label asp-for="MinStockLevel" class="form-label fw-semibold text-secondary">Min Stock Level <span class="fw-normal text-muted">(Optional)</span></label>
                    <input asp-for="MinStockLevel" class="form-control" type="number" placeholder="0" />
                    <span asp-validation-for="MinStockLevel" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <label asp-for="ReorderQty" class="form-label fw-semibold text-secondary">Reorder Qty <span class="fw-normal text-muted">(Optional)</span></label>
                    <input asp-for="ReorderQty" class="form-control" type="number" placeholder="0" />
                    <span asp-validation-for="ReorderQty" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="StandardCost" class="form-label fw-semibold text-secondary">Standard Cost (₹) <span class="fw-normal text-muted">(Optional)</span></label>
                    <input asp-for="StandardCost" class="form-control" type="number" step="0.01" placeholder="0" />
                    <span asp-validation-for="StandardCost" class="text-danger"></span>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="row mt-5">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary px-4 py-2 me-2" style="font-weight: 500;">Save Item</button>
                    <a asp-action="Index" class="btn btn-light px-4 py-2 border text-dark" style="font-weight: 500;">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
