@page
@model UniqPac_ERP.Areas.Identity.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    Layout = null; // No layout for this page, or we can use the default auth layout if preferred
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniqPac ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <style>
        body {
            background-color: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }
        .access-denied-container {
            text-align: center;
            padding: 40px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            max-width: 500px;
        }
        .icon-container {
            font-size: 80px;
            color: #dc3545;
            margin-bottom: 20px;
        }
    </style>
</head>
<body>
    <div class="access-denied-container">
        <div class="icon-container">
            <i class="ph-fill ph-warning-octagon"></i>
        </div>
        <h1 class="text-danger mb-3">Access Denied</h1>
        <p class="text-muted mb-4">You do not have permission to view this resource.</p>
        <p class="text-muted mb-4 small">If you believe you should have access, please contact your system administrator or try logging out and logging back in if your permissions were recently updated.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="~/" class="btn btn-primary px-4 py-2">Go to Dashboard</a>
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="~/">
                <button type="submit" class="btn btn-outline-secondary px-4 py-2">Log Out</button>
            </form>
        </div>
    </div>
</body>
</html>
